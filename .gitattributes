# Normalise to LF in the repository. Husky hooks and the Alpine-based Docker build
# run under `sh`, which fails on CRLF line endings.
* text=auto eol=lf

*.sh        text eol=lf
.husky/*    text eol=lf
Dockerfile  text eol=lf
*.conf      text eol=lf

# Binary assets — never touched.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.woff  binary
*.woff2 binary
*.ttf  binary
*.eot  binary
*.otf  binary
*.gz   binary
*.pdf  binary
